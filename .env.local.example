# Template only — copy to .env.local and put real values there.
# .env.local is gitignored; this file is not.
#
# Project Settings → API in the Supabase dashboard.
# Only NEXT_PUBLIC_-prefixed vars reach the browser; other prefixes are
# ignored by Next.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Same page, "service_role" secret — server-only, never NEXT_PUBLIC_. Read
# by src/lib/upstox/token.ts to fetch the saved Upstox token.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# developer.upstox.com / apps.upstox.com. Not read by any code yet — see
# the comment in .env.local for why (the app uses a manually-pasted access
# token instead, via /settings).
UPSTOX_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
UPSTOX_API_SECRET=xxxxxxxxxx
